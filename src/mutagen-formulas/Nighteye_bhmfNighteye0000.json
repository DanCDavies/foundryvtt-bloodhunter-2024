  "system": {
    "description": {
      "value": "<p><strong>Effect:</strong> You gain Darkvision with a range of 60 feet; if you already have Darkvision, its range increases by 60 feet.</p>\n<p><strong>Side Effect:</strong> You have Disadvantage on attack rolls and on Wisdom (Perception) checks that rely on sight while you, your target, or what you’re trying to perceive is in direct sunlight.</p>\n<section class=\"secret\"><p><strong>Foundry Note</strong></p><p>Sunlight sensitivity (Disadvantage on attacks/perception in direct sunlight) cannot be automated via Active Effects. Track this manually.</p></section>",
      "chat": ""
    },
